# Multi-API Transcription System Environment Variables

# ===== REQUIRED =====

# Deepgram API Key (Primary - 600 min/month free)
# Get from: https://console.deepgram.com
DEEPGRAM_API_KEY=sk-your-deepgram-key-here

# Speechmatics API Key (Secondary - 100 min/month free)
# Get from: https://www.speechmatics.com/signup
SPEECHMATICS_API_KEY=your-speechmatics-key-here

# ===== OPTIONAL =====

# Server Configuration
PORT=3000
NODE_ENV=development

# Whisper Configuration (Local/Unlimited)
# Models: tiny, base (recommended), small, medium, large
WHISPER_MODEL=base

# Usage Checking Interval (milliseconds)
USAGE_CHECK_INTERVAL=10000

# Maximum concurrent transcriptions
MAX_CONCURRENT_TRANSCRIPTIONS=5

# CORS - Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ===== DATABASE (OPTIONAL) =====
DATABASE_URL=sqlite:///./transcriptions.db

# ===== ERROR TRACKING (OPTIONAL) =====
SENTRY_DSN=

# ===== NOTES =====
# - Deepgram is primary (fastest, best accuracy)
# - Speechmatics is secondary (fallback)
# - Whisper is tertiary (unlimited but local processing)
# - System auto-switches when API quota is exceeded
# - All free tiers reset on 1st of month (UTC)
# - Total free tier: 700+ minutes per month

