# Environment Variables Example
# Copy this to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS - Allow these origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Optional: Database (for storing transcriptions)
DATABASE_URL=sqlite:///./transcriptions.db

# Optional: Send notifications via webhook
WEBHOOK_URL=https://your-webhook-endpoint.com/transcription

# Optional: Sentry error tracking
SENTRY_DSN=

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
